{
  "entities": {
    "Image": {
      "title": "Image Metadata",
      "description": "Metadata for uploaded images synced to GitHub and jsDelivr CDN",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique image document ID"
        },
        "name": {
          "type": "string",
          "description": "Filename without extension"
        },
        "originalName": {
          "type": "string",
          "description": "Original file name uploaded"
        },
        "url": {
          "type": "string",
          "description": "Generated jsDelivr CDN URL"
        },
        "githubPath": {
          "type": "string",
          "description": "Relative path of the image inside the GitHub repository"
        },
        "folder": {
          "type": "string",
          "description": "Folder where the image is organized"
        },
        "size": {
          "type": "integer",
          "description": "Optimized file size in bytes"
        },
        "width": {
          "type": "integer",
          "description": "Optimized image width in pixels"
        },
        "height": {
          "type": "integer",
          "description": "Optimized image height in pixels"
        },
        "format": {
          "type": "string",
          "description": "Image format, typically webp"
        },
        "uploadedBy": {
          "type": "string",
          "description": "Firebase Auth UID of the admin who uploaded it"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the image was uploaded"
        },
        "tags": {
          "type": "array",
          "description": "AI-generated or manual tags for image search"
        }
      },
      "required": ["id", "name", "originalName", "url", "githubPath", "folder", "size", "width", "height", "format", "uploadedBy", "uploadedAt"]
    },
    "Folder": {
      "title": "Folder Definition",
      "description": "Folder created by the admin for clustering media assets",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique folder ID"
        },
        "name": {
          "type": "string",
          "description": "Human-friendly name of the folder"
        },
        "createdBy": {
          "type": "string",
          "description": "Auth UID of the folder creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "name", "createdBy", "createdAt"]
    },
    "Settings": {
      "title": "GitHub & CDN Configurations",
      "description": "Secure repository and CDN configurations for GitCDN",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth User ID"
        },
        "githubToken": {
          "type": "string",
          "description": "Personal Access Token for GitHub API operations"
        },
        "githubRepo": {
          "type": "string",
          "description": "Target repository name"
        },
        "githubOwner": {
          "type": "string",
          "description": "GitHub username or organization owning the repo"
        },
        "githubBranch": {
          "type": "string",
          "description": "Default branch for storing files, e.g., main"
        },
        "cdnMode": {
          "type": "string",
          "description": "CDN service type, e.g., jsdelivr"
        },
        "imageQuality": {
          "type": "integer",
          "description": "Compression quality factor between 1 and 100"
        },
        "useAiTagging": {
          "type": "boolean",
          "description": "Whether to auto-generate tags using Gemini Vision API on upload"
        }
      },
      "required": ["userId", "githubToken", "githubRepo", "githubOwner", "githubBranch", "cdnMode", "imageQuality", "useAiTagging"]
    }
  },
  "firestore": {
    "images/{imageId}": {
      "schema": "Image",
      "description": "Collection storing image metadata documents"
    },
    "folders/{folderId}": {
      "schema": "Folder",
      "description": "Collection storing folder definitions"
    },
    "settings/{userId}": {
      "schema": "Settings",
      "description": "Collection storing encrypted or private GitHub CDN configuration per admin"
    }
  }
}
